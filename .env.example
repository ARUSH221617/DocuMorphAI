# DocuMorph AI Configuration
# OpenAI Compatible API Endpoint (Local vLLM, Ollama, OpenRouter, or OpenAI)
OPENAI_API_BASE_URL="http://localhost:20128/v1"
OPENAI_API_KEY="your-api-key-here"

# Default Model Identifier
AI_DEFAULT_MODEL="ag/gemini-3.8-flash-high"

# Output Directory Path
OUTPUT_PATH="./output"

# Parallel Conversion Worker Ceiling
MAX_CONCURRENT_JOBS="3"
